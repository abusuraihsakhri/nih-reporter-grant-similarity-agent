{
  "openapi": "3.1.0",
  "info": {
    "title": "Grant Rule Evaluation API",
    "description": "Deterministic threshold and anomaly-rule evaluation; no NIH grant similarity or live model inference.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters",
        "responses": {
          "200": {
            "description": "JSON counter object"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisory response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit metadata with credential",
        "responses": {
          "200": {
            "description": "Signed audit metadata and integrity check result"
          },
          "403": {
            "description": "Missing or incorrect audit access token"
          },
          "503": {
            "description": "Audit access token not configured"
          }
        },
        "security": [
          {
            "auditToken": []
          }
        ]
      }
    },
    "/": {
      "get": {
        "summary": "Self-contained browser rule console",
        "responses": {
          "200": {
            "description": "HTML interface"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "auditToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Audit-Token"
      }
    }
  }
}
